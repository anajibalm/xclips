# ============================================
# xClips / Live Assist — Master Gitignore
# ============================================

# --- Vault & Sensitive data ---
vault/
.vault/
.hermes/

# --- Environment & secrets ---
.env
.env.local
.env.*.local
*.key
*.pem
*.enc

# --- Node & Web Dependencies / Build ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# --- Rust & Tauri Desktop Build ---
src-tauri/target/
src-tauri/gen/
target/
*.pdb

# --- xClips Databases & Local State ---
data/
*.sqlite
*.sqlite-journal
*.db
*.db-journal
*.db-wal
*.db-shm

# --- xClips Media Renders, Uploads & Temp Files ---
public/renders/
public/uploads/
public/temp/
temp/
output/
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.ass
*.srt
*.vtt

# Keep test fixture files if added in the future
!tests/fixtures/**

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS junk ---
Thumbs.db
.DS_Store
Desktop.ini
$RECYCLE.BIN/

# --- Editor & IDE ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~
*.bak
